rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users to read/write choir members
    match /choirMembers/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write attendance history
    match /attendanceHistory/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write teams
    match /teams/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // **NEW: Allow authenticated users to read/write Sunday schedule**
    match /sundaySchedule/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
